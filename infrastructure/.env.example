# Copier en .env (ne jamais commiter .env) et renseigner. docker compose le lit automatiquement.

# Base de données. Mot de passe long et aléatoire : openssl rand -base64 24
DB_USER=lingua
DB_PASSWORD=

# Secret partagé par les 3 services pour signer et valider les JWT (HS512).
# Base64, au moins 512 bits : openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Compte admin créé au premier démarrage du gateway (son mot de passe n'est plus modifié ensuite).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Stockage des images et des sons.
# Image Docker de MinIO. minio/minio n'est plus publié sur Docker Hub : copie de la dernière image officielle.
MINIO_IMAGE=ghcr.io/bassayiene/minio-ci:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# URL de MinIO vue par le navigateur : sert à construire l'URL des images et des sons.
# Exemple : http://IP_DU_VPS:9000
MINIO_PUBLIC_URL=

# Ports publiés sur le serveur.
GATEWAY_PORT=8090
FRONTEND_PORT=8091
MINIO_PORT=9000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Y mettre l'adresse de l'interface de test, par exemple http://IP_DU_VPS:8091
CORS_ALLOWED_ORIGINS=http://localhost:4200

# "dev" charge les catégories et questions d'exemple, "prod" ne charge que le strict nécessaire.
LIQUIBASE_CONTEXTS=prod
