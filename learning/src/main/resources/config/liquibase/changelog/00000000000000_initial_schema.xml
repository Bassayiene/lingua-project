<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00000000000001" author="lingua">
        <createTable tableName="language">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(10)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_language_code"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="category">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="language_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="ux_category_language_name" tableName="category" columnNames="language_id, name"/>
        <addForeignKeyConstraint constraintName="fk_category_language"
                                 baseTableName="category" baseColumnNames="language_id"
                                 referencedTableName="language" referencedColumnNames="id"/>

        <createTable tableName="question">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="question_text" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="difficulty" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_question_category"
                                 baseTableName="question" baseColumnNames="category_id"
                                 referencedTableName="category" referencedColumnNames="id"/>
        <createIndex indexName="idx_question_category_difficulty" tableName="question">
            <column name="category_id"/>
            <column name="difficulty"/>
        </createIndex>

        <createTable tableName="choice">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="question_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="choice_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="choice_text" type="varchar(500)"/>
            <column name="image_url" type="varchar(1000)"/>
            <column name="correct" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_choice_question"
                                 baseTableName="choice" baseColumnNames="question_id"
                                 referencedTableName="question" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex indexName="idx_choice_question" tableName="choice">
            <column name="question_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="00000000000002" author="lingua">
        <createTable tableName="difficulty_setting">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="difficulty" type="varchar(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_difficulty_setting_difficulty"/>
            </column>
            <column name="points" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="penalty_points" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="time_limit_seconds" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="sound_setting">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event" type="varchar(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_sound_setting_event"/>
            </column>
            <column name="audio_url" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="00000000000003" author="lingua">
        <createTable tableName="learner_score">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_login" type="varchar(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_learner_score_user_login"/>
            </column>
            <column name="total_points" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="correct_answers" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_learner_score_total_points" tableName="learner_score">
            <column name="total_points" descending="true"/>
        </createIndex>

        <createTable tableName="question_attempt">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_login" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="question_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="choice_id" type="bigint"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="answered_at" type="timestamp with time zone"/>
            <column name="points_delta" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Deleting a question removes its attempts; the points already won or lost stay in learner_score -->
        <addForeignKeyConstraint constraintName="fk_question_attempt_question"
                                 baseTableName="question_attempt" baseColumnNames="question_id"
                                 referencedTableName="question" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <!-- Editing a question replaces its choices: past attempts keep their outcome but lose the chosen choice -->
        <addForeignKeyConstraint constraintName="fk_question_attempt_choice"
                                 baseTableName="question_attempt" baseColumnNames="choice_id"
                                 referencedTableName="choice" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex indexName="idx_question_attempt_user_status" tableName="question_attempt">
            <column name="user_login"/>
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_question_attempt_question_user" tableName="question_attempt">
            <column name="question_id"/>
            <column name="user_login"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
